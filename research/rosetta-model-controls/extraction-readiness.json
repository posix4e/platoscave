  "independent_source_disposition": "Reviewer rechecked current source after amendments: previous dispatch and journal/publication findings resolved; no further extractor blocker identified. Downstream consumers must enforce COMPLETE and both output hashes.",
  "findings_and_fixes": [
    {
      "finding": "Uncontrolled CPU worker counts made the first artificial vision throughput measurements slow.",
      "resolution": "Pinned vision intra-op and inter-op threads to one, matching the existing DINO helper precedent. Repeated synthetic checks; no model selection used corpus outcomes.",
      "superseded_source_sha256": "7826c6e616aa5ba62d038fb36a49ed311552b48c353b2cfeccd54cb3165c2ef8"
    },
    {
      "finding": "Default AVX512 versus reference AVX2 dispatch changed resize output on 8 of 10 artificial fixtures, by up to 0.0175073 in normalized pixels.",
      "resolution": "Set process-local ATEN_CPU_CAPABILITY=avx2 and MKL_CBWR=AVX2,STRICT before importing Torch; assert actual AVX2 and pin both flags in vision contracts. No installed packages or frozen helper files changed. Current source matches every tensor byte on all ten independent fixtures.",
      "superseded_source_sha256": "1d177ff8a8fa2c0550e7baabedcfb28f8cc56c56318bf85462a6bc317ea156d3",
      "limit": "Fixture equality does not establish universal numerical equivalence or authenticate pixels behind the released cached embeddings."
    },
    {
      "finding": "The earlier draft reserved its destination only after inference and could leave an apparently final tensor before final verification.",
      "resolution": "Reserve attempt directory and started receipt before inference; fsync each completed row; preserve FAILED receipts; publish COMPLETE.json atomically only after source and output checks. Artificial inference-failure and final-recheck-failure tests pass in both runtimes.",
      "retry_policy": "From scratch in a new attempt directory only; consumers require COMPLETE and both output hashes, and reject FAILED or absent COMPLETE."
    }
  ],
  "timing_limitations": "Artificial timings include encoder calls and vision preprocessing but exclude corpus JPEG decoding, source verification, row journals and output serialization. VM load can change. They are not guaranteed corpus throughput.",
  "scientific_limitations": [
    "The panel compares fixed encoder pipelines, including different readouts, dimensions, training and stored precision.",
    "Original cached DINOv2/MPNet features retain their BF16 reduction semantics; added encoders save FP32.",
    "A shared square224 recipe has been tested; no native-preprocessing sensitivity analysis has been performed."
  ],
  "release_requirement": "Publish a reviewed scientific protocol, extraction lock and outer release manifest before any real feature extraction. This readiness record enables no corpus run."
